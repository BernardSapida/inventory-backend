# Virtual environment
venv/

# Environment variables
.env

# Python cache
__pycache__/
*.py[cod]

# YOLO training runs
runs/

# Dataset (large files, not for git)
dataset/

# Logs
*.log
logs/

# Firebase service account key(s) - serviceAccountKey.json is the current
# active project's key; serviceAccountKey-old.json etc. are prior projects'
# keys kept around during migration.
*serviceAccountKey*.json

# Firestore data backups (may contain production data)
backups/
